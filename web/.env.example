# PostgreSQL connection strings.
# DATABASE_URL: the runtime database (Railway provides this in production).
# TEST_DATABASE_URL: an isolated database for `npm test` — must differ from
# DATABASE_URL, because the test suite wipes all data in it.
DATABASE_URL=
TEST_DATABASE_URL=

# Google Calendar integration (see GOOGLE-CALENDAR.md for full setup)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — override the OAuth redirect URI.
# Default: <origin of the request>/api/calendar/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/calendar/google/callback
