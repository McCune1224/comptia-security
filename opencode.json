{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tutor",
  "agent": {
    "tutor": {
      "color": "accent",
      "temperature": 0.3,
      "steps": 40,
      "prompt": "{file:./.opencode/prompts/tutor.md}",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": { "*": "allow" },
        "task": "allow",
        "skill": "allow",
        "glob": "allow",
        "grep": "allow",
        "fff_find_files": "allow",
        "fff_grep": "allow",
        "fff_multi_grep": "allow",
        "webfetch": "allow"
      }
    }
  }
}
